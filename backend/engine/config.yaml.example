_version: 1
provider:
  default: glm
  fallback_chain:
  - glm
  - kimicode
  deepseek:
    base_url: https://api.deepseek.com
    model: deepseek-v4-flash
    api_key: YOUR_DEEPSEEK_API_KEY_HERE
  mimo:
    base_url: ''
    model: ''
    api_key: ''
  kimicode:
    base_url: https://kimi.com
    model: kimi-latest
    api_key: YOUR_KIMI_API_KEY_HERE
  glm:
    base_url: https://glm.com
    model: glm-4
    api_key: YOUR_GLM_API_KEY_HERE
tavily:
  api_key: YOUR_TAVILY_API_KEY_HERE
assistant_model:
  base_url: https://api.deepseek.com
  model: deepseek-v4-flash
  api_key: YOUR_ASSISTANT_API_KEY_HERE
embedding_model:
  base_url: ''
  model: ''
  api_key: ''
agent:
  max_turns: 50
  identity: agent.identity.yaml
  smart_stop:
    max_turns: 50
    max_tokens: 200000
    timeout_seconds: 600
    no_progress_rounds: 3
    loop_detect_rounds: 2
  tracing:
    enabled: false
    endpoint: http://localhost:4318/v1/traces
context:
  compact_threshold: 0.8
  keep_recent: 3
  hot_memory_limit: 10
  warm_memory_limit: 20
tools:
  toolsets:
  - web
  - file
  - code
  max_result_chars: 12000
  safe_to_parallel_default: true
  default_timeout: 60
