{
  "productName": "MindCloud Zome",
  "version": "2.0.0",
  "identifier": "com.mindcloud.zome",
  "build": {
    "beforeDevCommand": "pnpm --filter @mindcloud/web dev",
    "beforeBuildCommand": "node scripts/ensure-web-dist.mjs && node scripts/prepare-engine.mjs",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "MindCloud Zome",
        "width": 1400,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:8848 ws://127.0.0.1:8848; script-src 'self' 'unsafe-inline' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"],
    "externalBin": ["binaries/zome-sidecar"],
    "resources": ["resources/engine", "resources/node"]
  }
}
